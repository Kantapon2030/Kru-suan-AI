PORT=3001
NODE_ENV=development
BASE_URL="http://localhost:3001"

# Database
DATABASE_URL="file:./krusuan-kb.db"

# JWT
JWT_SECRET=krusuan_kb_secret_jwt_key_2026

# Typhoon LLM
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_BASE_URL="https://api.opentyphoon.ai/v1"
TYPHOON_MODEL="typhoon-v2.5-30b-a3b-instruct"

# Vapi Integration
VAPI_API_KEY=
VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_VOICE_PROVIDER=openai
VAPI_VOICE_ID=alloy
VAPI_VOICE_MODEL=tts-1-hd
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2

# System 1 Sync API Key
SYSTEM1_KB_API_KEY=krusuan_sync_secure_key_2026
