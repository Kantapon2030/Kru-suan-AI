datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 👤 User
// ==========================================
model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  passwordHash  String
  profileImage  String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plots         Plot[]
  conversations Conversation[]
  notifications Notification[]
}

// ==========================================
// 🌱 Plot (แปลง)
// ==========================================
model Plot {
  id                  String    @id @default(cuid())
  userId              String
  name                String          // "แปลงมะเขือเทศ #01"
  cropName            String          // "มะเขือเทศ"
  cropEmoji           String          // "🍅"
  area                Float?          // พื้นที่ (ตร.ม.)
  location            String?
  soilType            String?
  waterSource         String?
  plantingDate        DateTime
  expectedHarvestDate DateTime?
  status              String    @default("ACTIVE") // ACTIVE | HARVESTED | ARCHIVED

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id])
  cropCycle           CropCycle?
  tasks               Task[]
  journalEntries      JournalEntry[]
  harvests            Harvest[]

  @@index([userId])
  @@index([status])
}

// ==========================================
// 🌿 Crop Cycle
// ==========================================
model CropCycle {
  id               String    @id @default(cuid())
  plotId           String    @unique
  currentStage     String          // SEED | SEEDLING | PLANTING | VEGETATIVE | FLOWERING | FRUIT | HARVEST
  stageStartedAt   DateTime  @default(now())
  dayCount         Int       @default(1)
  progress         Int       @default(0)   // 0–100

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plot             Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  stages           StageLog[]
}

model StageLog {
  id          String    @id @default(cuid())
  cropCycleId String
  stage       String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  notes       String?

  cropCycle   CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([cropCycleId])
}

// ==========================================
// 📋 Task
// ==========================================
model Task {
  id             String    @id @default(cuid())
  plotId         String
  stage          String
  title          String
  description    String?
  instructions   String?         // JSON: [{step, text, tip}]
  emoji          String    @default("📋")
  estimatedTime  Int?            // นาที
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  dueDate        DateTime?
  completedAt    DateTime?
  sortOrder      Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plot           Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  evidence       Evidence[]

  @@index([plotId])
  @@index([status])
  @@index([dueDate])
}

model Evidence {
  id        String   @id @default(cuid())
  taskId    String
  type      String         // PHOTO | TEXT | VOICE
  content   String         // file path หรือ text content
  note      String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ==========================================
// 📓 Farm Journal
// ==========================================
model JournalEntry {
  id        String   @id @default(cuid())
  plotId    String
  type      String         // OBSERVATION | TASK_COMPLETED | PHOTO | NOTE | AI_ADVICE | STAGE_CHANGE
  emoji     String   @default("📝")
  title     String
  content   String?
  photo     String?        // file path
  metadata  String?        // JSON
  createdAt DateTime @default(now())

  plot      Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId])
  @@index([createdAt])
}

// ==========================================
// 🍅 Harvest
// ==========================================
model Harvest {
  id           String   @id @default(cuid())
  plotId       String
  date         DateTime @default(now())
  quantity     Float
  unit         String   @default("kg")
  qualityGrade String?        // A | B | C
  photos       String?        // JSON array of file paths
  notes        String?
  createdAt    DateTime @default(now())

  plot         Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
  product      Product?

  @@index([plotId])
}

// ==========================================
// 🛒 Market
// ==========================================
model Product {
  id             String   @id @default(cuid())
  harvestId      String   @unique
  cropName       String
  quantity       Float
  unit           String   @default("kg")
  qualityGrade   String?
  expectedPrice  Float?
  status         String   @default("READY") // READY | LISTED | NEGOTIATING | SOLD
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  harvest        Harvest  @relation(fields: [harvestId], references: [id], onDelete: Cascade)
}

// ==========================================
// 💬 Conversation & Messages
// ==========================================
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  plotId    String?         // เชื่อมกับแปลง (ถ้ามี)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String         // user | assistant
  content        String
  metadata       String?        // JSON: { quickActions, usedKnowledge, plotContext }
  channel        String   @default("text")  // text | voice
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==========================================
// 🎙️ Voice Session (Vapi call ↔ Conversation)
// ==========================================
model VoiceSession {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  vapiCallId     String    @unique
  status         String    @default("in_progress") // in_progress | completed | failed
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSec    Int?

  @@index([userId])
  @@index([conversationId])
}

// ==========================================
// 🧠 Knowledge Base (แทน RAG)
// ==========================================
model KnowledgeEntry {
  id          String   @id @default(cuid())
  crop        String         // "มะเขือเทศ" | "ALL"
  topic       String         // "การให้น้ำ" | "โรคพืช" | "ปุ๋ย" | "การเก็บเกี่ยว" ...
  subtopic    String?        // "ใบเหลือง" | "เพลี้ย" ...
  stage       String?        // เฉพาะ stage ไหน (null = ทุก stage)
  region      String?        // "ภาคใต้" | null = ทั่วไป
  condition   String?        // "ช่วงฝนตก" | "อากาศร้อน" | null
  question    String         // คำถามที่เกษตรกรมักถาม
  answer      String         // คำตอบ/ความรู้
  source      String?        // "เกษตรกรรุ่นเก๋า ลุงสมชาย" | "กรมวิชาการเกษตร"
  tags        String?        // JSON array: ["น้ำ","รดน้ำ","ความชื้น"]
  isVerified  Boolean  @default(false)
  hubId       String?  @unique // id ของ KnowledgeCandidate ฝั่ง Knowledge Hub (System 2) กันซิงค์ซ้ำ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([crop])
  @@index([topic])
  @@index([stage])
}

// ==========================================
// 🔔 Notifications
// ==========================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String         // TASK_DUE | STAGE_CHANGE | HARVEST_READY | WEATHER | GENERAL
  title     String
  body      String?
  data      String?        // JSON: { plotId, taskId, ... }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}
