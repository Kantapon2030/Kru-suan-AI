PORT=3000
NODE_ENV=development

DATABASE_URL="file:./dev.db"

JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

TYPHOON_API_KEY=your-opentyphoon-api-key
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_MAX_TOKENS=1024
TYPHOON_TEMPERATURE=0.7

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

BASE_URL=http://localhost:3000
VAPI_PUBLIC_KEY=your-vapi-web-public-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_VOICE_PROVIDER=openai
VAPI_ADVISOR_VOICE_ID=alloy
VAPI_VOICE_MODEL=tts-1-hd
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2

# Knowledge Hub (System 2) sync — ต้องตรงกับ SYSTEM1_KB_API_KEY ใน knowledge-hub/.env
KNOWLEDGE_HUB_URL=http://localhost:3001
SYSTEM1_KB_API_KEY=your-system1-sync-key
